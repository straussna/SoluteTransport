# File formatting defaults and per-language overrides.
# Language formatter options belong in that tool's repository configuration.
# Markdown guides link to configuration; they do not duplicate these settings.

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,jsonc,yml,yaml,html,css,scss,js,jsx,ts,tsx,mjs,cjs}]
indent_size = 2

[*.{csproj,props,targets,slnx,xml}]
indent_size = 2

[src/SoluteTransport/SoluteTransport.csproj]
charset = utf-8-bom
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false

[*.{bat,cmd}]
end_of_line = crlf
